---
import sessions from "../data/sessions.json";

/* 日付が新しい順に並べる */
const sortedSessions = [...sessions].sort(
	(a, b) =>
		new Date(b.date).getTime() -
		new Date(a.date).getTime()
);
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />

		<title>TRPG SESSION LOG</title>

		<meta
			name="description"
			content="日雀がTRPGで遊んだ卓の記録をまとめています。僭越ながら敬称略で記載させていただきます。"
		/>
	</head>

	<body>
		<main>

			<!-- =========================
			     ヘッダー
			========================= -->

			<header class="page-header">

				<p class="eyebrow">
					SESSION ARCHIVE
				</p>

				<h1>
					TRPG SESSION LOG
				</h1>

				<p class="description">
					TRPGで遊んだ卓の記録をまとめています。
					僭越ながら敬称略で記載させていただきます。
				</p>

			</header>


			<!-- =========================
			     検索・絞り込み
			========================= -->

			<section class="archive-tools" aria-label="卓報告の検索と絞り込み">

				<div class="search-row">
					<label class="search-box">
						<span class="visually-hidden">卓報告を検索</span>
						<input
							id="session-search"
							type="search"
							placeholder="シナリオ名・作者・参加者などを検索"
							autocomplete="off"
						/>
					</label>

					<label class="year-select-wrap">
						<span class="year-label">YEAR</span>
						<select id="year-filter" aria-label="年で絞り込む">
							<option value="ALL">ALL YEARS</option>
						</select>
					</label>
				</div>

				<div class="filter-row">
					<div class="filters" aria-label="参加区分で絞り込む">
						<button
							class="filter-button is-active"
							type="button"
							data-filter="ALL"
						>
							ALL
						</button>

						<button
							class="filter-button"
							type="button"
							data-filter="PL"
						>
							PL
						</button>

						<button
							class="filter-button"
							type="button"
							data-filter="KP"
						>
							KP
						</button>

						<button
							class="filter-button"
							type="button"
							data-filter="KPC"
						>
							KPC
						</button>
					</div>

					<p class="result-count" id="result-count" aria-live="polite"></p>
				</div>

			</section>


			<!-- =========================
			     卓一覧
			========================= -->

			<section
				class="session-grid"
				id="session-grid"
				aria-live="polite"
			></section>

			<p class="empty-message" id="empty-message" hidden>
				条件に一致する卓報告がありません。
			</p>

			<nav
				class="pagination"
				id="pagination"
				aria-label="ページ切り替え"
			></nav>


			<!-- JavaScriptで一覧を生成するための元データ -->
			<script
				id="sessions-data"
				type="application/json"
				set:html={JSON.stringify(sortedSessions)}
			></script>

		</main>


		<!-- =========================
		     詳細モーダル
		========================= -->

		<div
			class="modal"
			id="session-modal"
			aria-hidden="true"
		>

			<div
				class="modal-backdrop"
				data-close-modal
			></div>


			<div
				class="modal-content"
				role="dialog"
				aria-modal="true"
				aria-labelledby="modal-title"
			>

				<button
					class="modal-close"
					type="button"
					data-close-modal
					aria-label="閉じる"
				>
					×
				</button>


				<!-- 卓画像 -->

				<div class="modal-image-area">

					<img
						id="modal-image"
						class="modal-image"
						alt=""
						draggable="false"
					/>

				</div>


				<!-- 卓詳細 -->

				<div class="modal-details">

					<h2 id="modal-title"></h2>

					<p
						id="modal-date"
						class="modal-date"
					></p>


					<dl>

						<div class="detail-row">
							<dt>System</dt>
							<dd id="modal-system"></dd>
						</div>


						<div class="detail-row">
							<dt>Writer</dt>
							<dd id="modal-writer"></dd>
						</div>


						<div class="detail-row">
							<dt>KP / KPC</dt>
							<dd id="modal-kpkpc"></dd>
						</div>


						<div class="detail-row">
							<dt>PC / PL</dt>
							<dd id="modal-pc"></dd>
						</div>


						<div class="detail-row">
							<dt>Result</dt>
							<dd id="modal-result"></dd>
						</div>

					</dl>

				</div>

			</div>

		</div>


		<!-- =========================
		     JavaScript
		========================= -->

		<script>
			/* =========================
			   基本設定
			========================= */

			const ITEMS_PER_PAGE = 30;

			const dataElement =
				document.querySelector("#sessions-data");

			const allSessions =
				dataElement
					? JSON.parse(dataElement.textContent || "[]")
					: [];

			const sessionGrid =
				document.querySelector("#session-grid");

			const searchInput =
				document.querySelector("#session-search");

			const yearFilter =
				document.querySelector("#year-filter");

			const filterButtons =
				document.querySelectorAll(".filter-button");

			const resultCount =
				document.querySelector("#result-count");

			const pagination =
				document.querySelector("#pagination");

			const emptyMessage =
				document.querySelector("#empty-message");


			/* =========================
			   モーダル
			========================= */

			const modal =
				document.querySelector("#session-modal");

			const modalImage =
				document.querySelector("#modal-image");

			const modalTitle =
				document.querySelector("#modal-title");

			const modalDate =
				document.querySelector("#modal-date");

			const modalSystem =
				document.querySelector("#modal-system");

			const modalWriter =
				document.querySelector("#modal-writer");

			const modalKpKpc =
				document.querySelector("#modal-kpkpc");

			const modalPc =
				document.querySelector("#modal-pc");

			const modalResult =
				document.querySelector("#modal-result");


			/* =========================
			   現在の絞り込み状態
			========================= */

			let activeCategory = "ALL";
			let activeYear = "ALL";
			let searchQuery = "";
			let currentPage = 1;


			/* =========================
			   年プルダウン生成
			========================= */

			const years =
				[
					...new Set(
						allSessions
							.map((session) =>
								String(session.date || "").slice(0, 4)
							)
							.filter(Boolean)
					)
				].sort((a, b) => Number(b) - Number(a));

			years.forEach((year) => {
				const option =
					document.createElement("option");

				option.value = year;
				option.textContent = `${year}年`;

				yearFilter.appendChild(option);
			});


			/* =========================
			   検索対象文字列
			========================= */

			function makeSearchText(session) {
				return [
					session.title,
					session.system,
					session.writer,
					session.kp,
					session.kpc,
					session.pc,
					session.result
				]
					.filter(Boolean)
					.join(" ")
					.toLocaleLowerCase("ja");
			}


			/* =========================
			   絞り込み
			========================= */

			function getFilteredSessions() {

				return allSessions.filter((session) => {

					const category =
						String(session.category || "")
							.trim()
							.toUpperCase();

					const year =
						String(session.date || "")
							.slice(0, 4);

					const categoryMatches =
						activeCategory === "ALL" ||
						category === activeCategory;

					const yearMatches =
						activeYear === "ALL" ||
						year === activeYear;

					const searchMatches =
						!searchQuery ||
						makeSearchText(session).includes(
							searchQuery
						);

					return (
						categoryMatches &&
						yearMatches &&
						searchMatches
					);
				});
			}


			/* =========================
			   卓カード生成
			========================= */

			function createSessionCard(session) {

				const card =
					document.createElement("button");

				card.className = "session-card";
				card.type = "button";

				card.setAttribute(
					"aria-label",
					`${session.title}の詳細を見る`
				);


				const imageWrap =
					document.createElement("div");

				imageWrap.className = "image-wrap";


				const image =
					document.createElement("img");

				image.src = session.image || "";
				image.alt = `${session.title}の卓報告`;
				image.className = "session-image";
				image.draggable = false;
				image.loading = "lazy";
				image.decoding = "async";


				imageWrap.appendChild(image);


				const info =
					document.createElement("div");

				info.className = "session-info";


				const title =
					document.createElement("h2");

				title.textContent =
					session.title || "無題";


				const time =
					document.createElement("time");

				time.dateTime =
					session.date || "";

				time.textContent =
					session.date
						? new Date(
							session.date
						).toLocaleDateString(
							"ja-JP"
						)
						: "—";


				info.appendChild(title);
				info.appendChild(time);

				card.appendChild(imageWrap);
				card.appendChild(info);


				card.addEventListener(
					"click",
					() => openModal(session)
				);

				return card;
			}


			/* =========================
			   一覧描画
			========================= */

			function renderSessions() {

				const filtered =
					getFilteredSessions();

				const totalCount =
					filtered.length;

				const totalPages =
					Math.max(
						1,
						Math.ceil(
							totalCount /
							ITEMS_PER_PAGE
						)
					);

				if (currentPage > totalPages) {
					currentPage = totalPages;
				}

				const startIndex =
					(currentPage - 1) *
					ITEMS_PER_PAGE;

				const pageSessions =
					filtered.slice(
						startIndex,
						startIndex +
						ITEMS_PER_PAGE
					);


				sessionGrid.replaceChildren();

				pageSessions.forEach((session) => {
					sessionGrid.appendChild(
						createSessionCard(session)
					);
				});


				emptyMessage.hidden =
					totalCount !== 0;


				const visibleCount =
					pageSessions.length;

				if (totalCount === 0) {
					resultCount.textContent =
						"0件";
				} else {
					resultCount.textContent =
						`${visibleCount}件表示 / 該当 ${totalCount}件`;
				}


				renderPagination(
					totalPages,
					totalCount
				);
			}


			/* =========================
			   ページ切り替え
			========================= */

			function renderPagination(
				totalPages,
				totalCount
			) {

				pagination.replaceChildren();

				if (
					totalCount === 0 ||
					totalPages <= 1
				) {
					pagination.hidden = true;
					return;
				}

				pagination.hidden = false;


				const previous =
					document.createElement("button");

				previous.type = "button";
				previous.className =
					"page-button page-prev";

				previous.textContent = "← PREV";
				previous.disabled =
					currentPage === 1;

				previous.addEventListener(
					"click",
					() => {
						currentPage -= 1;
						renderSessions();
						scrollToArchiveTop();
					}
				);


				const pageInfo =
					document.createElement("span");

				pageInfo.className = "page-info";
				pageInfo.textContent =
					`${currentPage} / ${totalPages}`;


				const next =
					document.createElement("button");

				next.type = "button";
				next.className =
					"page-button page-next";

				next.textContent = "NEXT →";
				next.disabled =
					currentPage === totalPages;

				next.addEventListener(
					"click",
					() => {
						currentPage += 1;
						renderSessions();
						scrollToArchiveTop();
					}
				);


				pagination.appendChild(previous);
				pagination.appendChild(pageInfo);
				pagination.appendChild(next);
			}


			function scrollToArchiveTop() {

				const tools =
					document.querySelector(
						".archive-tools"
					);

				if (!tools) return;

				const top =
					tools.getBoundingClientRect().top +
					window.scrollY -
					20;

				window.scrollTo({
					top,
					behavior: "smooth"
				});
			}


			/* =========================
			   モーダルを開く
			========================= */

			function openModal(session) {

				modalImage.src =
					session.image || "";

				modalImage.alt =
					`${session.title}の卓報告`;

				modalTitle.textContent =
					session.title || "—";

				modalDate.textContent =
					session.date
						? new Date(
							session.date
						).toLocaleDateString(
							"ja-JP"
						)
						: "—";

				modalSystem.textContent =
					session.system || "—";

				modalWriter.textContent =
					session.writer || "—";


				const kpKpcLines = [];

				if (session.kp) {
					kpKpcLines.push(
						`KP：${session.kp}`
					);
				}

				if (session.kpc) {
					kpKpcLines.push(
						`KPC：${session.kpc}`
					);
				}

				modalKpKpc.textContent =
					kpKpcLines.length > 0
						? kpKpcLines.join("\n")
						: "—";


				modalPc.textContent =
					session.pc || "—";

				modalResult.textContent =
					session.result || "—";


				modal.classList.add(
					"is-open"
				);

				modal.setAttribute(
					"aria-hidden",
					"false"
				);

				document.body.style.overflow =
					"hidden";
			}


			/* =========================
			   モーダルを閉じる
			========================= */

			function closeModal() {

				modal.classList.remove(
					"is-open"
				);

				modal.setAttribute(
					"aria-hidden",
					"true"
				);

				document.body.style.overflow =
					"";
			}


			document
				.querySelectorAll(
					"[data-close-modal]"
				)
				.forEach((button) => {
					button.addEventListener(
						"click",
						closeModal
					);
				});


			document.addEventListener(
				"keydown",
				(event) => {
					if (
						event.key === "Escape" &&
						modal.classList.contains(
							"is-open"
						)
					) {
						closeModal();
					}
				}
			);


			/* 卓画像の右クリックを無効化 */

			document.addEventListener(
				"contextmenu",
				(event) => {

					const target =
						event.target;

					if (
						target instanceof HTMLElement &&
						(
							target.classList.contains(
								"session-image"
							) ||
							target.classList.contains(
								"modal-image"
							)
						)
					) {
						event.preventDefault();
					}
				}
			);


			/* =========================
			   絞り込みイベント
			========================= */

			filterButtons.forEach((button) => {

				button.addEventListener(
					"click",
					() => {

						activeCategory =
							button.dataset.filter ||
							"ALL";

						currentPage = 1;

						filterButtons.forEach(
							(item) => {
								item.classList.remove(
									"is-active"
								);
							}
						);

						button.classList.add(
							"is-active"
						);

						renderSessions();
					}
				);
			});


			yearFilter.addEventListener(
				"change",
				() => {

					activeYear =
						yearFilter.value;

					currentPage = 1;

					renderSessions();
				}
			);


			searchInput.addEventListener(
				"input",
				() => {

					searchQuery =
						searchInput.value
							.trim()
							.toLocaleLowerCase("ja");

					currentPage = 1;

					renderSessions();
				}
			);


			/* =========================
			   初期表示
			========================= */

			renderSessions();

		</script>

	</body>
</html>


<style>

	/* =========================
	   基本設定
	========================= */

	:global(*) {
		box-sizing: border-box;
	}


	:global(html) {
		background: #1f2023;
		color: #eeeeee;

		font-family:
			"Yu Gothic UI",
			"Yu Gothic",
			"Meiryo",
			sans-serif;
	}


	:global(body) {
		margin: 0;
		min-width: 320px;
		background: #1f2023;
	}


	:global(button) {
		font-family: inherit;
	}


	/* =========================
	   メイン
	========================= */

	main {
		width: min(
			100% - 40px,
			1120px
		);

		margin: 0 auto;

		padding:
			80px 0
			120px;
	}


	/* =========================
	   ヘッダー
	========================= */

	.page-header {
		margin-bottom: 56px;
	}


	.eyebrow {
		margin: 0 0 10px;

		color: #92969e;

		font-size: 11px;
		font-weight: 700;
		letter-spacing: 0.2em;
	}


	h1 {
		margin: 0;

		font-size:
			clamp(
				34px,
				6vw,
				58px
			);

		line-height: 1.15;
		letter-spacing: 0.03em;
	}


	.description {
		margin-top: 18px;

		color: #aeb1b7;

		font-size: 14px;
		line-height: 1.8;
	}


	/* =========================
	   検索・絞り込み
	========================= */

	.archive-tools {
		margin-bottom: 32px;
	}

	.search-row {
		display: grid;
		grid-template-columns:
			minmax(0, 1fr)
			180px;
		gap: 10px;
		margin-bottom: 14px;
	}

	.search-box {
		display: block;
	}

	.search-box input,
	.year-select-wrap select {
		width: 100%;
		height: 42px;
		border: 1px solid #45474d;
		border-radius: 0;
		background: transparent;
		color: #eeeeee;
		font: inherit;
		font-size: 13px;
	}

	.search-box input {
		padding: 0 14px;
	}

	.search-box input::placeholder {
		color: #777b82;
	}

	.search-box input:focus,
	.year-select-wrap select:focus {
		outline:
			1px solid
			#92969e;
		outline-offset: -1px;
	}

	.year-select-wrap {
		position: relative;
		display: block;
	}

	.year-label {
		position: absolute;
		z-index: 1;
		top: -7px;
		left: 10px;
		padding: 0 5px;
		background: #1f2023;
		color: #777b82;
		font-size: 9px;
		font-weight: 700;
		letter-spacing: 0.12em;
		pointer-events: none;
	}

	.year-select-wrap select {
		padding: 0 34px 0 12px;
		cursor: pointer;
		color-scheme: dark;
	}

	.filter-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
	}

	.filters {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin: 0;
	}

	.filter-button {
		min-width: 62px;
		padding: 8px 16px;
		border:
			1px solid
			#45474d;
		background: transparent;
		color: #92969e;
		font-size: 12px;
		font-weight: 700;
		letter-spacing: 0.08em;
		cursor: pointer;
		transition:
			background-color 0.2s ease,
			color 0.2s ease,
			border-color 0.2s ease;
	}

	.filter-button:hover {
		border-color: #747880;
		color: #eeeeee;
	}

	.filter-button.is-active {
		border-color: #eeeeee;
		background: #eeeeee;
		color: #1f2023;
	}

	.result-count {
		flex: 0 0 auto;
		margin: 0;
		color: #7f838a;
		font-size: 11px;
		letter-spacing: 0.04em;
	}

	.visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	.empty-message {
		margin: 64px 0;
		color: #888c93;
		font-size: 14px;
		text-align: center;
	}


	/* =========================
	   ページ切り替え
	========================= */

	.pagination {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 22px;
		margin-top: 64px;
	}

	.pagination[hidden] {
		display: none;
	}

	.page-button {
		padding: 9px 14px;
		border: 1px solid #45474d;
		background: transparent;
		color: #eeeeee;
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 0.08em;
		cursor: pointer;
	}

	.page-button:hover:not(:disabled) {
		border-color: #eeeeee;
	}

	.page-button:disabled {
		opacity: 0.28;
		cursor: default;
	}

	.page-info {
		min-width: 70px;
		color: #888c93;
		font-size: 12px;
		text-align: center;
	}


	/* =========================
	   卓一覧
	========================= */

	.session-grid {
		display: grid;

		grid-template-columns:
			repeat(
				3,
				minmax(0, 1fr)
			);

		gap:
			36px
			20px;
	}


	.session-card {
		display: block;

		min-width: 0;

		padding: 0;

		border: 0;

		background: transparent;

		color: inherit;

		text-align: left;

		cursor: pointer;
	}


	.image-wrap {
		overflow: hidden;

		aspect-ratio: 4 / 3;

		background: #2a2b2f;
	}


	.session-image {
		display: block;

		width: 100%;
		height: 100%;

		object-fit: cover;

		user-select: none;
		-webkit-user-drag: none;

